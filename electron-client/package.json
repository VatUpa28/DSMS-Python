{
  "name": "dsms-desktop",
  "version": "1.0.0",
  "description": "DiamondStar Management System desktop client",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "Vatsal Upadhyay",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "DSMS",
  "build": {
    "appId": "com.diamondstar.dsms",
    "productName": "DSMS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "DSMS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DSMS",
      "artifactName": "DSMS-Setup.${ext}",
      "runAfterFinish": true
    }
  }
}
